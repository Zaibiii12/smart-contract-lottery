# Deployer wallet address used for on-chain deployments (Sepolia) and local Anvil scripts.
# This is a public address, not a secret - safe to share.
DEPLOYER_ADDRESS=0xYourAddressHere

# Your Sepolia RPC endpoint (e.g. from Alchemy or Infura)
SEPOLIA_RPC_URL=

# Private key of the deploying account - NEVER commit the real value.
# Used via --account or --private-key flags depending on your deploy method.
PRIVATE_KEY=